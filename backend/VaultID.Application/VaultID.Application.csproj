<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VaultID.Application - BUSINESS LOGIC (Layer 3, Backend)
    =======================================================
    ALL business rules live here: event-sourcing orchestration, the permission
    engine, sharing/consent/expiry logic, propagation, and projections.

    References:
      - VaultID.Domain   (models + events)
      - VaultID.Services (data-access abstractions ONLY)

    It depends on the service layer's INTERFACES, never on a concrete store, so
    the database technology can change without touching business logic.
    It does NOT reference the Api (web) project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultID.Domain\VaultID.Domain.csproj" />
    <ProjectReference Include="..\..\services-layer\VaultID.Services\VaultID.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
